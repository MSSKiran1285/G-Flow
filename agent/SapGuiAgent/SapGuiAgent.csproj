<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SapGuiAgent</RootNamespace>
    <!-- Windows-only agent (spec §1); dynamic COM interop + GDI screenshot capture both
         require the Windows TFM rather than bare net8.0. See docs/assumptions.md. -->
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.63.0" />
    <PackageReference Include="Google.Protobuf" Version="3.27.0" />
    <PackageReference Include="Grpc.Tools" Version="2.64.0" PrivateAssets="All" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.7" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="../../proto/uiadapter.proto" GrpcServices="Server" ProtoRoot="../../proto" />
  </ItemGroup>

</Project>
